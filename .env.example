# Copy to .env and fill in. Never commit the real .env.

# MongoDB Atlas connection string (same database as the client)
MONGO_URI=

# Stripe secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=

# The client app's exact URL, no trailing slash.
# Used for CORS, Stripe redirects and fetching the JWT public keys (/api/auth/jwks).
# Leave unset locally (defaults to http://localhost:3000).
CLIENT_URL=https://<your-client>.vercel.app
